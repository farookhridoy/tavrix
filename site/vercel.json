{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/manual", "destination": "https://github.com/farookhridoy/tavrix/blob/main/docs/MANUAL.md", "permanent": false },
    { "source": "/releases", "destination": "https://github.com/farookhridoy/tavrix/releases", "permanent": false },
    { "source": "/source", "destination": "https://github.com/farookhridoy/tavrix", "permanent": false },
    { "source": "/issues", "destination": "https://github.com/farookhridoy/tavrix/issues", "permanent": false },
    { "source": "/download", "destination": "/#download", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src https://api.github.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    { "source": "/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
