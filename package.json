{
  "name": "tavrix",
  "version": "1.6.0",
  "description": "Tavrix: an SSH terminal with a remote file browser and editor for macOS",
  "main": "dist/main/main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/main/*.test.js",
    "dist": "npm run build && electron-builder --mac -c.mac.identity=- -c.mac.hardenedRuntime=false && node scripts/shrink-dmg.mjs",
    "dist:dir": "npm run build && electron-builder --mac --dir -c.mac.identity=- -c.mac.hardenedRuntime=false",
    "dist:release": "npm run build && electron-builder --mac -c.mac.notarize=true"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ssh2": "^1.15.6",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "monaco-editor": "0.52.2",
    "ssh2": "^1.17.0"
  },
  "author": "Tavrix contributors",
  "build": {
    "appId": "app.tavrix.desktop",
    "productName": "Tavrix",
    "copyright": "Copyright © 2026 Tavrix contributors",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/main/**/*.js",
      "!dist/main/**/*.test.js",
      "src/renderer/**/*",
      "node_modules/@xterm/xterm/lib/xterm.js",
      "node_modules/@xterm/xterm/css/xterm.css",
      "node_modules/@xterm/addon-fit/lib/addon-fit.js",
      "node_modules/monaco-editor/min/vs/**/*",
      "!node_modules/monaco-editor/min/vs/**/nls.messages.*.js",
      "package.json",
      "!node_modules/monaco-editor/{dev,esm}/**",
      "!node_modules/@xterm/*/{src,out}/**",
      "!**/*.map",
      "!**/*.d.ts",
      "!node_modules/ssh2/lib/protocol/crypto/build/**",
      "!node_modules/cpu-features/**",
      "!node_modules/nan/**",
      "!**/*.md",
      "!**/LICENSE*",
      "!**/*.markdown",
      "!**/test/**",
      "!**/*.ts"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "Tavrix ${version}",
      "format": "UDBZ"
    },
    "npmRebuild": false,
    "electronLanguages": [
      "en"
    ],
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/farookhridoy/tavrix.git"
  }
}
